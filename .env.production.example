# Open Privacy Suite — Production Environment Variables
# Copy to .env and fill in your values:
#   cp .env.production.example .env
#
# Alternatively, keep non-secret settings in a structured TOML file and point at
# it with CONFIG_FILE (template: config.example.toml). Environment variables
# always override the file, so keep secrets (JWT_SECRET, ADMIN_API_TOKEN,
# DATABASE_URL, REDIS_PASSWORD, …) in the environment, not in the file.
# CONFIG_FILE=/etc/privacy-proxy/config.toml

# === Required ===

# Docker image version (from DockerHub releases)
PRIVACY_PROXY_VERSION=v0.5.0

# Chain-indexer image tag from GHCR (ghcr.io/gateway-fm/chain-indexer).
# Pin to a tagged release in production — `latest` is fine for smoke
# tests, but production deployments should pin so that an upstream push
# does not silently roll the indexer underneath you.
INDEXER_VERSION=latest

# Public URL where the proxy is reachable (used for OAuth callbacks, CORS)
BASE_URL=https://proxy.yourdomain.com

# Ethereum node URL (JSON-RPC endpoint)
NODE_URL=http://your-ethereum-node:8545

# JWT secrets — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional JWT rotation window: previous secrets accepted for VALIDATION only
# (never signing), comma-separated. To rotate a secret without logging every
# session out, promote the new value to JWT_SECRET / JWT_REFRESH_SECRET and move
# the outgoing one here; drop it once the longest token TTL has elapsed.
# JWT_SECRET_PREVIOUS=
# JWT_REFRESH_SECRET_PREVIOUS=

# Admin API token — generate with: openssl rand -hex 32
# FULL super-admin (reads + writes + platform/fleet, any org). Hold inside your
# own trust boundary (Gateway ops / the bundled MCP admin tool).
ADMIN_API_TOKEN=

# Operator token (RD-1132, optional) — generate with: openssl rand -hex 32
# RESTRICTED onboarder credential, also sent as X-Admin-Token. Platform-only:
# create/manage orgs + mint org admins, but NO per-org tenant reads or mutations
# (and no impersonation). Issue to a 3rd-party that onboards client orgs but must
# not see/touch tenant data. Leave empty to disable the operator tier.
OPERATOR_API_TOKEN=

# Cross-organization authorization oracle (disabled by default).
# Enabling this exposes a state-dependent policy oracle to one dedicated
# service identity, limited to the explicit organization allowlist.
# Modes: disabled | verdict_only | full_simulation
CROSS_ORG_AUTHORIZATION_ORACLE_MODE=disabled
CROSS_ORG_AUTHORIZATION_ORACLE_TOKEN=
# Comma-separated organization UUIDs. Required whenever mode is enabled.
CROSS_ORG_AUTHORIZATION_ORACLE_ORG_IDS=

# Privado verifier DID — identifies this proxy when requesting ZK proofs.
# This is a self-chosen identifier (no registration needed). Pick any
# unique DID string for your deployment. The wallet shows this to the user
# and the proof response is checked against it for consistency.
# Only needed if using Privado ID auth (not needed for Azure AD-only setups).
VERIFIER_ID=did:privado:verifier:your-network-name

# Wallet networks. The proxy resolves each login's DID against a per-network
# on-chain state contract. Privado ID and Billions are different iden3 networks,
# so each needs its own resolver.
#   - Privado ID app  -> privado:main  (PRIVADO_RPC_URL / PRIVADO_STATE_CONTRACT)
#   - Billions app    -> billions:main (BILLIONS_RPC_URL / BILLIONS_STATE_CONTRACT)
#
# privado:main works out of the box. billions:main is OFF until you set
# BILLIONS_RPC_URL — there is no default on purpose: a stale default registers a
# resolver that cannot be reached, so Billions sign-ins fail obscurely instead of
# telling you the setting is missing. Unset means the network is refused clearly
# and the login page advertises Privado ID only. The state contract below is
# already correct for that chain, so enabling Billions is one variable.
# BILLIONS_RPC_URL=https://your-billions-rpc.example.com
# BILLIONS_STATE_CONTRACT=0x3C9acB2205Aa72A05F6D77d708b5Cf85FCa3a896

# Database connection string
# Use the built-in postgres (default) or point to an external DB
DATABASE_URL=postgres://postgres:postgres@postgres:5432/privacy_proxy?sslmode=disable

# Redis password — used by the built-in redis container and the default REDIS_URL.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=

# === Optional ===

# Password for the built-in postgres container (default: postgres)
# POSTGRES_PASSWORD=postgres

# Redis connection URL. Defaults to the built-in redis container using REDIS_PASSWORD.
# Override to point at an external Redis (must be password-protected — unauthed Redis is rejected).
# REDIS_URL=redis://:yourpassword@your-redis-host:6379/0

# CORS allowed origins (default: same as BASE_URL)
# CORS_ALLOWED_ORIGINS=https://proxy.yourdomain.com,https://explorer.yourdomain.com

# Additional CIDRs for internal API access (comma-separated)
# Appended to defaults: localhost, Docker (172.16/12), RFC1918 (10/8, 192.168/16), Tailscale (100.64/10)
# TRUSTED_INTERNAL_CIDRS=10.100.0.0/16,fd00::/8

# Host ports (default: 8080 for backend, 5173 for frontend)
# HOST_PORT_PROXY=8080
# HOST_PORT_UI=5173

# Azure AD / Microsoft Entra ID (optional SSO)
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
# Service-principal (M2M) login audience; defaults to AZURE_AD_CLIENT_ID.
# AZURE_AD_SP_AUDIENCE=

# Explorer database (for block-explorer integration)
# EXPLORER_DATABASE_URL=postgres://user:pass@explorer-db:5432/explorer?sslmode=disable

# Explorer pseudonym key (RD-1164, optional but recommended in production).
# Under a pseudonymous disclosure grant the explorer shows a stable, non-reversible
# "Address-XXXX" alias for each address. Setting this key also makes those aliases
# NON-ENUMERABLE — an attacker cannot recompute the alias from a candidate address.
# Set it once and keep it stable; changing it changes every alias.
# Generate with: openssl rand -hex 32
# EXPLORER_PSEUDONYM_KEY=

# Separate append-only audit database for access_logs (RD-1147).
# access_logs (the access-log audit trail + its tamper-evident hash chain,
# checkpoints, and anchor) ALWAYS lives in its OWN Postgres database — the main
# DATABASE_URL no longer contains an access_logs table. This lets the runtime
# identity APPEND access-log rows but NOT rewrite or delete history. Two DSNs:
#   - AUDIT_ADMIN_DATABASE_URL: admin/owner role. Runs the lean audit-DB
#     migrations at startup and performs retention prune (DELETE).
#   - AUDIT_DATABASE_URL: runtime role. MUST connect as the RESTRICTED
#     privacy_proxy_app role (INSERT+SELECT only on access_logs) — that is what
#     makes the append-only seal actually bite. If it connects as the owner, the
#     seal is a no-op.
#
# IMPORTANT: The app connects to an ALREADY-PROVISIONED audit database and runs
# the lean migrations against it. The app NEVER runs CREATE DATABASE — your infra
# (Terraform/RDS/etc.) must create the database and the restricted role.
#
# If you leave these UNSET, they are DERIVED from DATABASE_URL by swapping the db
# name to "<name>_audit" on the SAME server, reusing DATABASE_URL's credentials.
# The derived default therefore connects as the OWNER, so the append-only seal is
# NOT enforced — set AUDIT_DATABASE_URL explicitly to the restricted role in
# production. An explicit URL may point at a different server.
# AUDIT_ADMIN_DATABASE_URL=postgres://audit_owner:pass@audit-db:5432/privacy_audit?sslmode=disable
# AUDIT_DATABASE_URL=postgres://privacy_proxy_app:pass@audit-db:5432/privacy_audit?sslmode=disable

# CoinGecko price fetching (disable if no internet access)
# DISABLE_COINGECKO=true

# Travel rule compliance enforcement
# ENABLE_TRAVEL_RULE=true

# Cluster-wide default compliance enforcement mode (RD-1044): "enforce" (block
# violations, the safe default) or "monitor" (allow the transfer but record it
# as would-have-blocked). Per-org compliance config overrides this. Sanctioned
# addresses always block regardless of mode.
# COMPLIANCE_DEFAULT_MODE=enforce

# Auto-KYC provisioning policy (RD-1131). When true, a NEWLY provisioned identity
# of that class is created already KYC-verified, skipping the manual KYC gate.
# Default false. RELAXES A COMPLIANCE CONTROL — enable only with Compliance/Legal
# sign-off. Existing users are never affected (KYC stays admin-managed).
# AUTO_KYC_PRIVADO=true
# AUTO_KYC_AZURE_USER=true
# AUTO_KYC_AZURE_SERVICE_PRINCIPAL=true

# RD-993 + RD-1006 silent SSO allowlist. Comma-separated entries of the form
# <client_id>:<bcrypt_hash>. Each first-party client must present its
# client_secret at /oauth/token (HTTP Basic or client_secret_post); the proxy
# bcrypt-compares it to the registered hash. Empty allowlist (default) = no
# client gets silent SSO; everything falls back to interactive Privado.
#
# Recipe (per-environment opaque client_id + 32-byte secret + bcrypt hash):
#   id="explorer-prod-$(openssl rand -hex 8)"
#   secret="$(openssl rand -hex 32)"
#   hash="$(htpasswd -bnBC 12 '' "$secret" | tr -d ':\n')"
#   echo "${id}:${hash}"  # → paste below, set $secret as SSO_CLIENT_SECRET on the explorer
#
# OAUTH_FIRST_PARTY_CLIENTS=explorer-prod-abcd1234:$2a$12$........

# Org-admin elevated transaction view (default: false = strict privacy).
# When true, org admins see user<->user transaction rows that are otherwise
# dropped (both parties private), with the value/amount preserved so it agrees
# with the Transfer event they can already read. Counterparty ADDRESSES STILL
# render as [PRIVATE] — this is a volume/timing audit view, NOT real-address
# disclosure. Every request that reveals such a row is written to rbac_audit_log
# (actor, endpoint, row count, client IP). Leave unset/false unless an org admin
# has a documented need to audit user activity volumes.
# ORG_ADMIN_VIEW_USER_TXS=true

# Read privacy profile: "standard" (default) or "strict". Under strict a
# transaction or receipt is returned only to a transaction participant (the
# viewer's linked address is the tx from/to), and an event only when an indexed
# address parameter of the contract's registered ABI is one of the viewer's
# linked addresses; admin claims, visibleTo and ORG_ADMIN_VIEW_USER_TXS grant no
# read access. Any other value refuses to start.
# PRIVACY_READ_PROFILE=strict
