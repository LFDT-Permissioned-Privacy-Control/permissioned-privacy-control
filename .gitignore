# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/

# Test binary
*.test

# Output of the go coverage tool
*.out
coverage/

# Dependency directories
vendor/
node_modules/
.go/

# Database
*.db
*.db-journal
*.sqlite
*.sqlite3
# PostgreSQL (local dev database dumps)
# But allow migration files
!internal/db/migrations/*.sql

# Environment (keep .env.example)
.env
.env.*
.*.env
!.env.example

# Quickstart demo state (tokens, ids) — written by scripts/quickstart-seed.sh
.quickstart-demo.json

# RPC namespaces config (keep example)
rpc-namespaces.json
!rpc-namespaces.example.json

# Local dev compose overrides (keep examples). Auto-included by privacy-dev-up.sh.
docker-compose.*.override.yml
!docker-compose.*.override.yml.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Build artifacts
frontend/dist/
frontend/build/
site/.next/
site/out/
site/node_modules/

# Secrets and certificates
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/

# Temporary files
tmp/
.tmp/

# Local docker compose overrides
docker-compose.override.yml

# Test results (Playwright)
test-results/
playwright-report/

# Isolated E2E harness runs (logs, metadata, and per-run browser artifacts)
.tmp/e2e-runs/

# Local dev notes (machine-specific)
*.local.md
*.local.sh
*.local.*
DEV.local.md
.env.deploy.local

# Claude Code settings (machine-specific)
.claude/*
# ...but share team skills through the repo (keep the rest of .claude local).
!.claude/skills/

# TypeScript build info (build artifact)
*.tsbuildinfo

# TypeScript declaration files for config (generated by tsc)
frontend/vite.config.d.ts
frontend/vite.config.js

# Foundry artifacts
cache/
out/
/lib/

# Vite cache
.vite/

# Git worktrees
.worktrees/
.agents/

# Built binaries (root level)
/privacy-proxy
/server

# Root package-lock (should be in frontend/)
/package-lock.json

# Temporary progress/notes files
TODO_*.md

# Internal audit reports (do not publish)
AUDIT_*.md
*_AUDIT*.md
OSS_AUDIT*.md
CONSOLIDATED_CRITICAL_FINDINGS*.md

# Backup files
*.bak

# Root level Solidity (use demo/contracts/ instead)
/src/*.sol

# Loadtest binary (not the cmd/loadtest/ source)
/loadtest
mcp/mcp

# Local MCP config (copy .mcp.json.example and fill in the admin token)
/.mcp.json
