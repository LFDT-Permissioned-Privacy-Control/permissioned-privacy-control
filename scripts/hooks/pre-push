#!/bin/bash
#
# Pre-push hook: Runs unit tests and e2e tests before allowing push
# To skip (emergency): git push --no-verify
#

set -e
# Propagate failures across pipes — without this, `make X | tail -20`
# would always report success because tail's exit code (0) wins. That
# bug masked an `make e2e` failure as "tests passed" on multiple PRs.
set -o pipefail

echo "========================================"
echo "  PRE-PUSH HOOK: Running tests"
echo "========================================"
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track failures
FAILED=0
SKIPPED_E2E=0

# Function to run a test and report
run_test() {
    local name="$1"
    local cmd="$2"

    echo -e "${YELLOW}▶ Running: ${name}${NC}"
    if eval "$cmd"; then
        echo -e "${GREEN}✓ ${name} passed${NC}"
        echo ""
    else
        echo -e "${RED}✗ ${name} FAILED${NC}"
        echo ""
        FAILED=1
    fi
}

# The server E2E harness deliberately relies on Linux host primitives for
# project locking and process-tree cleanup. A stock macOS checkout does not
# provide all of them. Since this hook is installed automatically, missing
# host capabilities skip only the harness-backed lanes; CI and explicit
# `make e2e-*` commands remain fail-closed.
e2e_host_ready() {
    local lane="$1"
    local output

    if output="$(./scripts/e2e-harness.sh preflight "$lane" 2>&1)"; then
        return 0
    fi

    echo -e "${YELLOW}⚠ Skipping ${lane} E2E in the local pre-push hook.${NC}"
    printf '%s\n' "$output"
    echo "  Run 'make e2e-doctor' on a supported host for the full diagnostic."
    echo "  CI/server E2E gates remain enforced."
    echo ""
    SKIPPED_E2E=1
    return 1
}

# Run unit tests (Go backend)
run_test "Go Unit Tests" "make test-unit 2>&1 | tail -20"

# Run Go E2E tests when this workstation can safely run the isolated harness.
if e2e_host_ready go; then
    run_test "Go E2E Tests" "make test-e2e 2>&1 | tail -20"
fi

# Run frontend tests
run_test "Frontend Tests" "make frontend-test 2>&1 | tail -20"

# Run the Dockerized browser lane. The Go lanes already ran above; the full
# server/nightly gate (make e2e) also includes privacy and would duplicate them.
if e2e_host_ready playwright; then
    echo -e "${YELLOW}▶ Running: Playwright E2E Tests (this may take a while...)${NC}"
    if make e2e-playwright 2>&1 | tail -50; then
        echo -e "${GREEN}✓ Playwright E2E Tests passed${NC}"
    else
        echo -e "${RED}✗ Playwright E2E Tests FAILED${NC}"
        FAILED=1
    fi
fi

echo ""
echo "========================================"

if [ $FAILED -eq 1 ]; then
    echo -e "${RED}  PUSH BLOCKED: Tests failed${NC}"
    echo "  Fix the issues and try again."
    echo "  To skip (emergency): git push --no-verify"
    echo "========================================"
    exit 1
elif [ $SKIPPED_E2E -eq 1 ]; then
    echo -e "${YELLOW}  Local checks passed; unsupported E2E lanes were skipped.${NC}"
    echo "  CI/server E2E gates remain enforced. Pushing..."
    echo "========================================"
    exit 0
else
    echo -e "${GREEN}  All tests passed! Pushing...${NC}"
    echo "========================================"
    exit 0
fi
