  "constraints": [
    {
      "table_name": "ops_identity_v2.metadata",
      "name": "metadata_migration_checksum_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (migration_checksum ~ '^sha256:[0-9a-f]{64}$'::text)"
    },
    {
      "table_name": "ops_identity_v2.metadata",
      "name": "metadata_namespace_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (namespace ~ '^sha256:[0-9a-f]{64}$'::text)"
    },
    {
      "table_name": "ops_identity_v2.metadata",
      "name": "metadata_pkey",
      "type": "p",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "PRIMARY KEY (singleton)"
    },
    {
      "table_name": "ops_identity_v2.metadata",
      "name": "metadata_recovery_epoch_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (recovery_epoch <> '00000000-0000-0000-0000-000000000000'::uuid)"
    },
    {
      "table_name": "ops_identity_v2.metadata",
      "name": "metadata_schema_version_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (schema_version = 2)"
    },
    {
      "table_name": "ops_identity_v2.metadata",
      "name": "metadata_singleton_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (singleton)"
    },
    {
      "table_name": "ops_identity_v2.pending_requests",
      "name": "pending_requests_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (created_at < expires_at AND expires_at <= (created_at + '00:05:00'::interval))"
    },
    {
      "table_name": "ops_identity_v2.pending_requests",
      "name": "pending_requests_encryption_key_id_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (octet_length(encryption_key_id) >= 1 AND octet_length(encryption_key_id) <= 128)"
    },
    {
      "table_name": "ops_identity_v2.pending_requests",
      "name": "pending_requests_namespace_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (namespace ~ '^sha256:[0-9a-f]{64}$'::text)"
    },
    {
      "table_name": "ops_identity_v2.pending_requests",
      "name": "pending_requests_pkey",
      "type": "p",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "PRIMARY KEY (request_id)"
    },
    {
      "table_name": "ops_identity_v2.pending_requests",
      "name": "pending_requests_profile_digest_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (profile_digest ~ '^sha256:[0-9a-f]{64}$'::text)"
    },
    {
      "table_name": "ops_identity_v2.pending_requests",
      "name": "pending_requests_profile_id_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (octet_length(profile_id) >= 1 AND octet_length(profile_id) <= 128)"
    },
    {
      "table_name": "ops_identity_v2.pending_requests",
      "name": "pending_requests_recipient_hash_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (octet_length(recipient_hash) = 32)"
    },
    {
      "table_name": "ops_identity_v2.pending_requests",
      "name": "pending_requests_recovery_epoch_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (recovery_epoch <> '00000000-0000-0000-0000-000000000000'::uuid)"
    },
    {
      "table_name": "ops_identity_v2.pending_requests",
      "name": "pending_requests_request_id_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (request_id <> '00000000-0000-0000-0000-000000000000'::uuid)"
    },
    {
      "table_name": "ops_identity_v2.pending_requests",
      "name": "pending_requests_secret_ciphertext_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (octet_length(secret_ciphertext) >= 28 AND octet_length(secret_ciphertext) <= 2048)"
    },
    {
      "table_name": "ops_identity_v2.pending_requests",
      "name": "pending_requests_state_hash_check",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (octet_length(state_hash) = 32)"
    },
    {
      "table_name": "ops_identity_v2.pending_requests",
      "name": "pending_requests_state_hash_key",
      "type": "u",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "UNIQUE (state_hash)"
    },
    {
      "table_name": "ops_identity_v2.privado_challenges",
      "name": "challenge_family_fk",
      "type": "f",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "FOREIGN KEY (family_id, namespace, recovery_epoch, provider_kind) REFERENCES ops_identity_v2.renewal_families(family_id, namespace, recovery_epoch, provider_kind) ON DELETE CASCADE"
    },
    {
      "table_name": "ops_identity_v2.privado_challenges",
      "name": "challenge_mode",
      "type": "c",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "CHECK (mode = 'login'::text AND family_id IS NULL AND current_generation IS NULL AND current_handle_hash IS NULL OR mode = 'renew'::text AND expected_actor_id IS NOT NULL AND family_id IS NOT NULL AND current_generation IS NOT NULL AND current_handle_hash IS NOT NULL)"
    },
    {
      "table_name": "ops_identity_v2.privado_challenges",
      "name": "challenge_scoped_unique",
      "type": "u",
      "validated": true,
      "deferrable": false,
      "deferred": false,
      "definition": "UNIQUE (request_id, namespace, recovery_epoch)"
    },
    {
      "table_name": "ops_identity_v2.privado_challenges",
      "name": "challenge_time",
      "type": "c",
      "validated": true,
