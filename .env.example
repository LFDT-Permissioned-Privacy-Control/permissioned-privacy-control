# =============================================================================
# Host port overrides — for running parallel stacks (worktrees, feature branches)
# =============================================================================
# These only change the HOST-side port mapping. Internal container ports are fixed.
# Default values match the original hardcoded ports, so leaving these unset
# changes nothing.
#
# Quick start for a parallel stack:
#   ./scripts/stack-ports.sh 100 > .env     # offsets all ports by +100
#   docker compose up -d --build
#
# HOST_PORT_RPC=8545       # Anvil JSON-RPC (default: 8545)
# HOST_PORT_DB=5432        # PostgreSQL (default: 5432)
# HOST_PORT_PROXY=8080     # Backend API / proxy (default: 8080)
# HOST_PORT_UI=5173        # Frontend dev server (default: 5173)

# Shared network name — block-explorer joins this network.
# Override to avoid collisions between parallel stacks.
# COMPOSE_NETWORK_NAME=privacy-proxy_proxy-network

# Backend configuration
# BASE_URL=http://localhost:8080

# Optional structured config file for non-secret settings (template:
# config.example.toml). Env vars always override the file. Secrets stay in env.
# CONFIG_FILE=./config.toml

# Cross-organization authorization oracle (high-risk, disabled by default).
# CROSS_ORG_AUTHORIZATION_ORACLE_MODE=disabled
# CROSS_ORG_AUTHORIZATION_ORACLE_TOKEN=
# CROSS_ORG_AUTHORIZATION_ORACLE_ORG_IDS=00000000-0000-0000-0000-000000000000

# Demo mode settings (development only)
# DEMO_AUTO_AUTH_DELAY=3

# Azure AD / Microsoft Entra ID authentication (optional)
# Register an app at https://portal.azure.com -> Microsoft Entra ID -> App registrations
# Redirect URI to add: http://localhost:5173/auth/azure/callback
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=common
# Service-principal (M2M / client-credentials) login audience for
# POST /api/v1/auth/azure/service-principal. Defaults to AZURE_AD_CLIENT_ID;
# set for a distinct API resource (e.g. api://<app-id>).
# AZURE_AD_SP_AUDIENCE=

# Chain-specific RPC methods (optional)
# Point to a JSON file with additional RPC namespaces for non-Ethereum chains.
# See rpc-namespaces.example.json for the format. Copy and customize:
#   cp rpc-namespaces.example.json rpc-namespaces.json
# EXTRA_RPC_NAMESPACES_FILE=./rpc-namespaces.json

# RPC API key encryption (RPC_API_KEY_ENCRYPTION_KEY, generate with: openssl rand -hex 32).
# Required in production; the proxy refuses to start on an invalid value. Rotate
# stored keys with: privacy-cli reencrypt-rpc-keys --old-key ... --new-key ...
# RPC_API_KEY_ENCRYPTION_KEY=

# Explorer pseudonym key (optional, recommended in production). Makes explorer
# "Address-XXXX" pseudonyms non-enumerable (an attacker can't recompute them from
# a candidate address). Set once and keep stable. Generate with: openssl rand -hex 32.
# EXPLORER_PSEUDONYM_KEY=

# Shared concurrency cap for anonymous /rpc traffic (no JWT). Defaults to
# MAX_CONCURRENT_REQUESTS; set 0 to disable.
# MAX_CONCURRENT_ANONYMOUS_REQUESTS=50

# Optional JWT rotation window: previous secrets accepted for validation only
# (never signing), comma-separated. Promote the new secret to JWT_SECRET /
# JWT_REFRESH_SECRET and move the outgoing one here to rotate without mass logout.
# JWT_SECRET_PREVIOUS=
# JWT_REFRESH_SECRET_PREVIOUS=
