FROM ghcr.io/foundry-rs/foundry:v1.4.0@sha256:f6a3fd201ae617fdc67bf7b3db9abdca7678e2589e15eda6bc84f88eb5239e04 AS foundry
FROM node:22-trixie-slim AS dev
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --prefix /opt/solc --ignore-scripts --omit=dev solc@0.8.35
ENV NODE_PATH=/opt/solc/node_modules \
    PYTHONUNBUFFERED=1 \
    OPS_RETH_BINARY=/usr/local/bin/ops-reth-approvals \
    OPS_EVIDENCE_DIR=/demo/evidence
COPY --from=foundry /usr/local/bin/cast /usr/local/bin/cast
WORKDIR /app
COPY go.mod ./
COPY poc/reth-signed-approvals/*.py poc/reth-signed-approvals/
COPY poc/reth-signed-approvals/contracts/ poc/reth-signed-approvals/contracts/
COPY node-approvals/docker/compile.js node-approvals/docker/compile.js
ENTRYPOINT ["python3", "poc/reth-signed-approvals/docker_demo.py"]
