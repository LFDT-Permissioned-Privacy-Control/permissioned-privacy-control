FROM golang:1.26.9-trixie AS builder-base

# Install build dependencies for CGO (required by go-rapidsnark).
# `apt-get upgrade` pulls patched libc/curl/etc. on every build to clear
# Aikido findings against the trixie baseline.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential \
    libgmp-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build identity (RD-1023). Passed in as build-args because the build
# context excludes .git, so `git describe` can't run here — the host
# Makefile / CI resolves these and forwards them. Each stage redeclares the
# ARGs with defaults (ARG values do not cross FROM boundaries), so an
# arg-less `docker build` still works and just reports version=dev.

# --- Dev build: includes mock auth for testing ---
FROM builder-base AS builder-dev
ARG VERSION=dev
ARG GIT_COMMIT=none
ARG BUILD_TIME=unknown
RUN CGO_ENABLED=1 GOOS=linux go build -tags mockauth \
	-ldflags "-X privacy-proxy/internal/version.Version=${VERSION} -X privacy-proxy/internal/version.Commit=${GIT_COMMIT} -X privacy-proxy/internal/version.BuildTime=${BUILD_TIME}" \
	-o /app/bin/privacy-proxy ./cmd/server

# --- Production build: no mock auth, no dev shortcuts ---
FROM builder-base AS builder-prod
ARG VERSION=dev
ARG GIT_COMMIT=none
ARG BUILD_TIME=unknown
RUN CGO_ENABLED=1 GOOS=linux go build -tags production \
	-ldflags "-X privacy-proxy/internal/version.Version=${VERSION} -X privacy-proxy/internal/version.Commit=${GIT_COMMIT} -X privacy-proxy/internal/version.BuildTime=${BUILD_TIME}" \
	-o /app/bin/privacy-proxy ./cmd/server

# --- Runtime base (shared) ---
FROM debian:trixie-slim AS runtime-base

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    postgresql-client \
    libgmp10 \
    && rm -rf /var/lib/apt/lists/*

# RD-1287: the pinned Solidity compiler, used to build an execution-policy
# artifact when a policy is submitted. Never on a request path.
#
# The version is exact, and the binary's checksum is verified, because a policy
# is approved as specific bytecode: a different compiler produces different
# bytecode from the same document, so "some solc" is not a substitute for this
# one. The build fails loudly if either changes.
#
# Static build from the upstream release, since Debian does not package solc.
# Both architectures come from the same upstream commit (47b9dedd), published
# per-arch on binaries.soliditylang.org, each with its own checksum.
ARG SOLC_VERSION=0.8.35
ARG SOLC_COMMIT=47b9dedd
ARG SOLC_SHA256_AMD64=fa8ac9a32d301ad023a36ee5a29f8e291fe3200c60244e43c142539e82a617f4
ARG SOLC_SHA256_ARM64=4218d2936d2b582bc5751dac548f97b36a8652b21ded52b60a1c1259143ee0e4
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) sha="${SOLC_SHA256_AMD64}" ;; \
      arm64) sha="${SOLC_SHA256_ARM64}" ;; \
      *) echo "ERROR: no pinned solc published for $arch; execution policies cannot be compiled here." >&2; exit 1 ;; \
    esac; \
    wget -q -O /usr/local/bin/solc \
      "https://binaries.soliditylang.org/linux-${arch}/solc-linux-${arch}-v${SOLC_VERSION}+commit.${SOLC_COMMIT}"; \
    echo "${sha}  /usr/local/bin/solc" | sha256sum -c -; \
    chmod +x /usr/local/bin/solc; \
    solc --version | grep -q "Version: ${SOLC_VERSION}+commit.${SOLC_COMMIT}"

RUN useradd -r -u 1000 -m appuser

# RD-1112: pre-create the async audit buffer dir (the recommended AUDIT_BUFFER_DIR)
# owned by the non-root runtime user. A fresh Docker named volume mounted here
# inherits this ownership, so the async buffer works with no host-side chown.
# (Kubernetes PVCs are root-owned regardless — set the pod's fsGroup to 1000;
# see docs/security/audit-integrity.)
RUN mkdir -p /var/lib/pp/auditbuf && chown -R appuser:appuser /var/lib/pp/auditbuf

WORKDIR /app
EXPOSE 8080

USER appuser

CMD ["./privacy-proxy"]

# --- Dev target ---
FROM runtime-base AS dev
COPY --from=builder-dev /app/bin/privacy-proxy .

# --- Prod target (default) ---
FROM runtime-base AS prod
COPY --from=builder-prod /app/bin/privacy-proxy .
