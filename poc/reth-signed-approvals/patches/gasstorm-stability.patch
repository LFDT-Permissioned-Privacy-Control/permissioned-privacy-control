diff --git a/dashboard/src/stores/load-test-websocket.test.ts b/dashboard/src/stores/load-test-websocket.test.ts
new file mode 100644
index 0000000..48527e0
--- /dev/null
+++ b/dashboard/src/stores/load-test-websocket.test.ts
@@ -0,0 +1,38 @@
+import { afterEach, expect, it, vi } from 'vitest';
+import { createWebSocketManager, type ChartTimeSeries } from './load-test-websocket';
+import type { GoLoadTestState } from './load-test-store-state';
+
+afterEach(() => vi.unstubAllGlobals());
+
+it('updates final sent and confirmed counters together after freezing the chart', () => {
+  let socket: FakeSocket;
+  class FakeSocket {
+    static OPEN = 1;
+    readyState = 1;
+    onmessage?: (event: { data: string }) => void;
+    close() {}
+    constructor() { socket = this; }
+  }
+  vi.stubGlobal('WebSocket', FakeSocket);
+  let state: Partial<GoLoadTestState> = { status: 'idle', elapsedTime: 0 };
+  let chart: ChartTimeSeries = { timestamps: [], txPerSec: [], mgasPerSec: [], fillRate: [] };
+  const manager = createWebSocketManager({
+    onStateUpdate: update => { state = {...state, ...update}; if (update.chartTimeSeries) chart = update.chartTimeSeries; },
+    onConnected() {}, onDisconnected() {}, onNewTestDetected() {}, onTestCompleted() {},
+    isHistoricalMode: () => false,
+    getCurrentStatus: () => state.status!, getElapsedTime: () => state.elapsedTime!,
+    getCurrentPeakTps: () => state.peakTps || 0, getChartTimeSeries: () => chart,
+  });
+  manager.connect();
+  const send = (status: string, elapsedMs: number, txSent: number, txConfirmed: number) => {
+    socket!.onmessage!({data: JSON.stringify({status, elapsedMs, durationMs: 10000, txSent, txConfirmed,
+      txFailed: 0, currentTps: 10, averageTps: 10, targetTps: 10, pattern: 'constant', transactionType: 'eth-transfer'})});
+  };
+  send('running', 9000, 98, 90);
+  send('verifying', 11000, 100, 99);
+  send('completed', 12000, 100, 100);
+  expect(state.txSentCount).toBe(100);
+  expect(state.txConfirmedCount).toBe(100);
+  expect(chart.timestamps).toEqual([9]);
+  manager.disconnect();
+});
