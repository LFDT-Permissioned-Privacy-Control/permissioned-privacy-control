--- /dev/null
+++ b/internal/loadgen/drain_test.go
@@ -0,0 +1,43 @@
+package loadgen
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/gateway-fm/loadgenerator/pkg/types"
+)
+
+func TestStopDoesNotCompleteWhileOldWorkerCanStillWrite(t *testing.T) {
+	lg := newTestLoadGenerator(t)
+	lg.status = types.StatusRunning
+	lg.ctx, lg.cancel = context.WithCancel(context.Background())
+	lg.startTime = time.Now()
+	lg.l2Client = nil
+	lg.storage = nil
+	lg.wg.Add(1)
+	workerReleased := false
+	defer func() {
+		if !workerReleased {
+			lg.wg.Done()
+		}
+	}()
+	stopped := make(chan struct{})
+	go func() { lg.StopTest(); close(stopped) }()
+	select {
+	case <-stopped:
+		t.Fatal("Stop completed before the old worker was drained")
+	case <-time.After(5200 * time.Millisecond):
+	}
+	lg.Reset()
+	if err := lg.StartTest(types.StartTestRequest{}); err == nil {
+		t.Fatal("a new test overlapped the old worker")
+	}
+	lg.wg.Done()
+	workerReleased = true
+	select {
+	case <-stopped:
+	case <-time.After(2 * time.Second):
+		t.Fatal("Stop did not finish after worker drained")
+	}
+}
