new file mode 100644
index 0000000..6f40861
--- /dev/null
+++ b/internal/rpc/nonce_recovery_test.go
@@ -0,0 +1,55 @@
+package rpc
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/ethereum/go-ethereum/crypto"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+)
+
+func TestNonceTooLowSucceedsOnlyForExactMinedTransaction(t *testing.T) {
+	for _, mined := range []bool{true, false} {
+		t.Run(map[bool]string{true: "same transaction mined", false: "nonce consumed by another transaction"}[mined], func(t *testing.T) {
+			raw := []byte{2, 1, 2, 3}
+			lookups := 0
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				var q JSONRPCRequest
+				if err := json.NewDecoder(r.Body).Decode(&q); err != nil {
+					t.Error(err)
+				}
+				response := map[string]any{"jsonrpc": "2.0", "id": q.ID}
+				switch q.Method {
+				case "eth_sendRawTransaction":
+					response["error"] = map[string]any{"code": -32000, "message": "nonce too low: next nonce 3, tx nonce 1"}
+				case "eth_getTransactionReceipt":
+					lookups++
+					if q.Params[0] != crypto.Keccak256Hash(raw).Hex() {
+						t.Error("looked up wrong transaction")
+					}
+					response["result"] = nil
+					if mined {
+						response["result"] = map[string]any{"status": "0x1", "gasUsed": "0x5208", "blockNumber": "0x3", "effectiveGasPrice": "0x7"}
+					}
+				default:
+					t.Error("unexpected method", q.Method)
+				}
+				json.NewEncoder(w).Encode(response)
+			}))
+			defer server.Close()
+			c := NewHTTPClient(ClientConfig{URL: server.URL, Timeout: time.Second})
+			err := c.SendRawTransaction(context.Background(), raw)
+			if mined && err != nil {
+				t.Fatal(err)
+			}
+			if !mined && !IsNonceTooLow(err) {
+				t.Fatalf("another transaction cannot count as success: %v", err)
+			}
+			if lookups != 1 {
+				t.Fatalf("expected exact receipt lookup, got %d", lookups)
+			}
+		})
+	}
+}
