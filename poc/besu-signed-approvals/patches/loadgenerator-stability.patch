+func TestResetDoesNotResetActiveVerificationOrInitialization(t *testing.T) {
+	for _, status := range []types.TestStatus{types.StatusInitializing, types.StatusVerifying} {
+		lg := newTestLoadGenerator(t)
+		lg.status = status
+		lg.Reset()
+		if lg.status != status {
+			t.Fatalf("reset raced active %s", status)
+		}
+		if err := lg.StartTest(types.StartTestRequest{}); err == nil {
+			t.Fatalf("start overlapped %s", status)
+		}
+	}
+}
+
+func TestStopCancelsInitializationAndVerification(t *testing.T) {
+	for _, state := range []types.TestStatus{types.StatusInitializing, types.StatusVerifying} {
+		lg := newTestLoadGenerator(t)
+		ctx, cancel := context.WithCancel(context.Background())
+		defer cancel()
+		lg.status = state
+		if state == types.StatusInitializing {
+			lg.initCtx = ctx
+			lg.initCancel = cancel
+		} else {
+			lg.verificationCancel = cancel
+		}
+		lg.StopTest()
+		if ctx.Err() == nil {
+			t.Fatalf("Stop did not cancel %s", state)
+		}
+	}
+}
