@@ -0,0 +1,28 @@
+package metrics
+
+import (
+	"testing"
+	"time"
+
+	"github.com/ethereum/go-ethereum/common"
+)
+
+func TestRetryAfterConfirmationDoesNotCountTwice(t *testing.T) {
+	c := NewMemoryCollector()
+	hash := common.Hash{1}
+	now := time.Now()
+	c.RecordTxSent(hash, now)
+	c.RecordTxConfirmed(hash, now.Add(time.Second))
+	// An ambiguous submission times out after mining; the retry has the same hash.
+	c.RecordTxSent(hash, now.Add(2*time.Second))
+	c.RecordTxConfirmed(hash, now.Add(3*time.Second))
+	if got := c.GetTxConfirmed(); got != 1 {
+		t.Fatalf("one mined transaction counted %d times", got)
+	}
+	c.Reset()
+	c.RecordTxSent(hash, now)
+	c.RecordTxConfirmed(hash, now.Add(time.Second))
+	if got := c.GetTxConfirmed(); got != 1 {
+		t.Fatalf("reset retained the prior test's confirmation: %d", got)
+	}
+}
