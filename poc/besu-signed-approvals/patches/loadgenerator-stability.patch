+func (*individualBatchClient) BatchConcurrencyCost(n int) int { return n }
+
+func TestUnbatchedRequestsUseIndividualConcurrencySlots(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	c := &individualBatchClient{&heldBatchClient{entered: make(chan struct{}), release: make(chan struct{}), received: make(chan string, 1)}}
+	s := New(Config{Client: c, Concurrency: 2})
+	defer close(c.release)
+	if !s.SendBatchAsync(ctx, [][]byte{[]byte("one"), []byte("two")}, nil) {
+		t.Fatal("initial batch rejected")
+	}
+	<-c.entered
+	if s.Available() != 0 {
+		t.Fatalf("two individual RPC calls used only %d slot(s)", 2-s.Available())
+	}
+	if s.SendBatchAsync(ctx, [][]byte{[]byte("three")}, nil) {
+		t.Fatal("exceeded actual RPC concurrency limit")
+	}
+}
+
+func TestWaitingProducerIsCancelledWithoutWaitingForActiveRPC(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	c := &individualBatchClient{&heldBatchClient{entered: make(chan struct{}), release: make(chan struct{}), received: make(chan string, 1)}}
+	s := New(Config{Client: c, Concurrency: 2})
+	defer close(c.release)
+	if !s.SendBatchAsync(ctx, [][]byte{[]byte("one"), []byte("two")}, nil) {
+		t.Fatal("initial batch rejected")
+	}
+	<-c.entered
+	waitCtx, stop := context.WithCancel(ctx)
+	defer stop()
+	queued := make(chan bool, 1)
+	go func() { queued <- s.SendBatchAwaitCapacity(waitCtx, [][]byte{[]byte("three")}, nil) }()
+	select {
+	case <-queued:
+		t.Fatal("producer did not wait for capacity")
+	case <-time.After(20 * time.Millisecond):
+	}
+	stop()
+	select {
+	case accepted := <-queued:
+		if accepted {
+			t.Fatal("cancelled producer submitted a transaction")
+		}
+	case <-ctx.Done():
+		t.Fatal("Stop did not interrupt the capacity wait")
+	}
+}
