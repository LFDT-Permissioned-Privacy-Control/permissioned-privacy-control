+++ b/internal/account/nonce_recovery_test.go
@@ -0,0 +1,56 @@
+package account
+
+import (
+	"context"
+	"github.com/gateway-fm/loadgenerator/internal/rpc"
+	"testing"
+)
+
+type nonceRPC struct {
+	rpc.Client
+	value uint64
+}
+
+func (c nonceRPC) GetNonce(context.Context, string) (uint64, error)          { return c.value, nil }
+func (c nonceRPC) GetConfirmedNonce(context.Context, string) (uint64, error) { return c.value, nil }
+
+func TestResyncPreservesUnminedGap(t *testing.T) {
+	a := &Account{}
+	first := a.ReserveNonce()
+	second := a.ReserveNonce()
+	a.ReserveNonce()
+	first.Commit()
+	second.Rollback()
+	if err := a.Resync(context.Background(), nonceRPC{value: 1}); err != nil {
+		t.Fatal(err)
+	}
+	if got := a.ReserveNonce().Value(); got != 1 {
+		t.Fatalf("resync abandoned missing nonce 1; next=%d", got)
+	}
+}
+func TestOldFailureCannotRecycleConsumedNonce(t *testing.T) {
+	a := &Account{}
+	old := a.ReserveNonce()
+	a.ReserveNonce()
+	a.ReserveNonce()
+	if err := a.ResyncFromChain(context.Background(), nonceRPC{value: 3}); err != nil {
+		t.Fatal(err)
+	}
+	old.Rollback()
+	if got := a.ReserveNonce().Value(); got != 3 {
+		t.Fatalf("late failure recycled consumed nonce %d", got)
+	}
+}
+
+func TestConsumedNonceCannotBeReused(t *testing.T) {
+	a := &Account{}
+	old := a.ReserveNonce()
+	current := a.ReserveNonce()
+	future := a.ReserveNonce()
+	current.Consumed()
+	old.Rollback()
+	future.Rollback()
+	if got := a.ReserveNonce().Value(); got != 2 {
+		t.Fatalf("consumed floor skipped a gap or reused consumed nonce: %d", got)
+	}
+}
